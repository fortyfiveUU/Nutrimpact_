<?xml version="1.0" encoding="utf-8"?>
<!-- Add food screen, portrait version: the form scrolls and the Add button
     stays fixed at the bottom. The form itself is in include_add_food_form. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddFoodActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAddFood"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/add_food_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/add_food_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <include layout="@layout/include_add_food_form" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/buttonAddToLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/add_food_button" />

</LinearLayout>
