<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and later. The food log database and the
     settings file are included in the phone's own Google backup (end-to-end
     encrypted with the screen lock) and in phone-to-phone transfers, so the
     diary isn't lost when the user changes phone. The whole database folder is included so Room's
     -wal file (recent changes) comes too; the app has only this one database.
     Nothing else is backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="nutrimpact_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="nutrimpact_settings.xml" />
    </device-transfer>
</data-extraction-rules>
