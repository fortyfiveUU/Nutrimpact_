<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 8 to 11 (Android 12 and later use
     data_extraction_rules.xml). Backs up only the food log database and the
     settings file. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="nutrimpact_settings.xml" />
</full-backup-content>
